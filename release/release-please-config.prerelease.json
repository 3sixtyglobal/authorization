{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prerelease",
	"pull-request-title-pattern": "chore: prerelease release prepared",
	"group-pull-request-title-pattern": "chore: release ${branch} [skip ci]",
	"pull-request-header": "chore: prerelease release prepared",
	"pull-request-footer": "This PR was generated by the Release Next GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "prerelease",
	"prerelease": true,
	"prerelease-type": "next",
	"packages": {
		"packages/authorization-models": {
			"package-name": "authorization-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/authorization-connector-entity-storage": {
			"package-name": "authorization-connector-entity-storage",
			"changelog-path": "docs/changelog.md"
		},
		"packages/authorization-connector-casbin": {
			"package-name": "authorization-connector-casbin",
			"changelog-path": "docs/changelog.md"
		},
		"packages/authorization-service": {
			"package-name": "authorization-service",
			"changelog-path": "docs/changelog.md"
		},
		"packages/authorization-rest-client": {
			"package-name": "authorization-rest-client",
			"changelog-path": "docs/changelog.md"
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"authorization-models",
				"authorization-connector-entity-storage",
				"authorization-connector-casbin",
				"authorization-service",
				"authorization-rest-client"
			]
		}
	]
}
